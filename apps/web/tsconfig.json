{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "../..",
    "paths": {
      "@/*": ["./src/*", "./src/shim/*"],
      "@tomilite/shared-ui/*": ["../../packages/shared-ui/src/*"]
    }
  },
  "include": ["src"]
}
